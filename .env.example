# Copy to ~/.xorcise/.env (chmod 0600). Real values are never committed.
#
# Every setting is the field name from xorcise.core.config.Settings prefixed with
# XORCISE_. Anything left unset falls back to the documented default, so the shortest
# working file is just the three model_* lines below.

# --- BYOM model (required for grading) ---------------------------------------
# XORCISE bundles no model. Point these at any OpenAI-compatible endpoint — a hosted
# provider, or something you serve yourself (vLLM, Ollama, LM Studio).
XORCISE_MODEL_KEY=
XORCISE_MODEL_BASE_URL=
XORCISE_MODEL_NAME=
# Raise this for slow or reasoning models — they can spend a while thinking before
# emitting a verdict. Seconds; default 120.
# XORCISE_MODEL_TIMEOUT_SECONDS=120

# --- Persistence -------------------------------------------------------------
# Defaults to sqlite:///<home>/xorcise.db, where <home> is ~/.xorcise unless
# XORCISE_HOME says otherwise. Set this only to move the database elsewhere; a
# server dialect additionally needs the matching extra (pip install "xorcise[postgres]").
# XORCISE_DATABASE_URL=sqlite:////absolute/path/to/xorcise.db

# --- Mission catalog ---------------------------------------------------------
# Defaults to the XORCISE.AI catalog, which is what a fresh install browses and pulls
# missions from. Point a dev build somewhere else here, or clear it to run fully
# offline — the bundled missions/ bundles need no catalog at all. The UI's
# connect/disconnect switch toggles access without discarding the endpoint.
# XORCISE_CATALOG_URL=
# XORCISE_CATALOG_KEY=

# --- Attachment link signing -------------------------------------------------
# A fresh random secret is generated per process when unset. Pin it only if you need
# signed attachment URLs to survive a restart or to be shared between processes.
# XORCISE_RUN_CONTROL_SIGNING_SECRET=
